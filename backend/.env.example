# Copy to .env (never commit .env). ASP.NET Core maps "__" to ":" in configuration keys.
ConnectionStrings__Default=Server=localhost,1433;Database=QuickBasket;User Id=sa;Password=<set-locally>;TrustServerCertificate=True
Jwt__SigningKey=<at-least-32-random-characters>
Payments__Provider=Mock            # Mock | Razorpay
Payments__Razorpay__KeyId=rzp_test_xxxxxxxxxxxxxx
Payments__Razorpay__KeySecret=<razorpay-test-key-secret>
Payments__Razorpay__WebhookSecret=<razorpay-test-webhook-secret>
Payments__Razorpay__AllowLive=false
Cors__AllowedOrigins__0=http://localhost:5173
